  "spikes": [
    {
      "name": "ten 429s of ten requests is a spike, reported when the next minute starts",
      "steps": [
        {
          "observe": {
            "t_ms": 1758799981000,
            "method": "GET",
            "route": "/v1/stock/{sku}",
            "status": 429,
            "repeat": 10
          },
          "want": []
        },
        {
          "observe": {
            "t_ms": 1758800040000,
            "method": "GET",
            "route": "/up",
            "status": 200
          },
          "want": [
            {
              "method": "GET",
              "route": "/v1/stock/{sku}",
              "window": 1758799980,
              "count": 10,
              "total": 10
            }
          ]
        }
      ]
    },
    {
      "name": "nine 429s is not a spike",
      "steps": [
        {
          "observe": {
            "t_ms": 1758799981000,
            "method": "GET",
            "route": "/v1/stock/{sku}",
            "status": 429,
            "repeat": 9
          },
          "want": []
        },
        {
          "tick_ms": 1758800041000,
          "want": []
        }
      ]
    },
